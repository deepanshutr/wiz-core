# Copy to ~/.config/wiz/state.env and adjust to your LAN.
# This file is committed; the real one is NOT.

# Daemon bind
# WIZ_BIND=127.0.0.1:8766

# Discovery (defaults assume 192.168.1.0/24)
# WIZ_BROADCAST=192.168.1.255
# WIZ_SUBNET=192.168.1.0/24

# Refresh + re-discover cadences (seconds)
# WIZ_REFRESH_INTERVAL_S=60
# WIZ_DISCOVER_INTERVAL_S=600

# Logging + state
# WIZ_LOG_LEVEL=INFO
# WIZ_STATE_DIR=~/.config/wiz
